# BuildSense Environment Variables Example
# Copy this file to .env and configure the credentials.

# API Host & Port configuration
PORT=8001
HOST=0.0.0.0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Database Configuration (PostgreSQL with pgvector - Cloud hosted via Neon/Supabase)
# format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# Note: For async operations, asyncpg uses: postgresql+asyncpg://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:password@localhost:5432/buildsense

# Redis Configuration (Cloud hosted via Upstash)
# format: redis://:[password]@[host]:[port] or rediss://:[password]@[host]:[port]
REDIS_URL=redis://localhost:6379/0

MAX_GLOBAL_DAILY_SPEND=10.00

# Telemetry / local developer observability
ENVIRONMENT=local
SERVICE_NAME=buildsense-api
TELEMETRY_ENABLED=true
TELEMETRY_LOG_LEVEL=INFO
TELEMETRY_LOG_FORMAT=json
LOCAL_TELEMETRY_VIEWER_ENABLED=true
LOCAL_TELEMETRY_MAX_EVENTS=1000
LOCAL_TELEMETRY_MAX_RUNS=100

# LangSmith Observability Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=buildsense-backend
